generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  accounts            Account[]
  bankConnections     BankConnection[]
  transactions        Transaction[]
  insights            Insight[]
  categorizationRules CategorizationRule[]
  budgets             Budget[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model BankConnection {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pluggyItemId     String    @unique
  connectorId      Int
  institution      String
  status           String
  executionStatus  String
  errorCode        String?
  errorMessage     String?
  lastSyncedAt     DateTime?
  consentExpiresAt DateTime?
  accounts         Account[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
}

model Account {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankConnectionId String?
  bankConnection   BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  pluggyAccountId  String?         @unique
  institution      String
  name             String
  type             AccountType
  balance          Decimal         @db.Decimal(12, 2)
  currency         String          @default("BRL")
  transactions     Transaction[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([bankConnectionId])
}

model Category {
  id                  String               @id @default(cuid())
  name                String               @unique
  color               String
  icon                String
  transactions        Transaction[]
  categorizationRules CategorizationRule[]
  budgets             Budget[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Transaction {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId           String
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId          String?
  category            Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pluggyTransactionId String?           @unique
  pluggyProviderId    String?
  description         String
  merchantName        String?
  amount              Decimal           @db.Decimal(12, 2)
  type                TransactionType
  status              TransactionStatus @default(POSTED)
  date                DateTime
  source              TransactionSource @default(MANUAL_SEED)
  categorySource      CategorySource    @default(PROVIDER)
  categoryConfidence  Float?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
}

model CategorizationRule {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  merchantKey   String
  merchantLabel String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, merchantKey])
  @@index([categoryId])
}

model Budget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  monthlyLimit Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([categoryId])
}

model PluggyWebhookEvent {
  id            String                  @id @default(cuid())
  pluggyEventId String                  @unique
  event         String
  itemId        String?
  payload       Json
  status        WebhookProcessingStatus @default(PENDING)
  attempts      Int                     @default(0)
  nextAttemptAt DateTime                @default(now())
  lockedAt      DateTime?
  lastAttemptAt DateTime?
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([itemId])
}

model Insight {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  summary   String
  severity  InsightSeverity
  period    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, period])
}

enum AccountType {
  CHECKING
  CREDIT_CARD
  SAVINGS
  INVESTMENT
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  POSTED
}

enum TransactionSource {
  MANUAL_SEED
  PLUGGY
}

enum CategorySource {
  PROVIDER
  RULE
  USER
  AI
}

enum InsightSeverity {
  INFO
  WARNING
  POSITIVE
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}
